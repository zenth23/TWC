@{
    ViewBag.Title = "_CustomSidenav";
    var context = this.Context;

    var appInstance = Application.Instance;
    var appEnv = appInstance.Environment.ToUpper();
    var mode = appInstance.DebugMode;
}
<link href="~/Content/custom-sidenav-new.css" rel="stylesheet" />

<style>
    :root {
        --sidebar-width: 250px;
        --transition-speed: 1s;
        --sidebar-bg: #dfb434;
        --sidebar-hover: #fff176;
        --sidebar-shadow: rgba(0, 0, 0, 0.2);
    }

    #sidebar {
        background-color: var(--sidebar-bg);
        width: var(--sidebar-width);
        height: 100vh;
        display: flex;
        flex-direction: column;
        margin-left: -250px;
        transition: margin var(--transition-speed) ease, width var(--transition-speed);
        color: white;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 9999;
        overflow: hidden;
    }

   

        #sidebar.visible {
            margin-left: 0;
        }

         #wrap.visible {
            margin-left: 0;
        }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding-right: 5px;
        padding-bottom: 20px; /* to avoid content behind footer */
    }

    #sidebar ul li {
        transition: background-color 0.8s ease;
        border-radius: 0.5rem;
        margin: 0.25rem 0.5rem;
    }

        #sidebar ul li:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

    #sidebar a {
        color: white;
        transition: color 0.8s ease, background-color 0.8s ease;
        border-radius: 0.5rem;
    }

        #sidebar a:hover {
            color: var(--sidebar-hover);
            background-color: rgba(0, 0, 0, 0.1);
        }

    .sidebar-header {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(8px);
        padding: 1.2rem;
        border-bottom: 1px solid rgba(255, 215, 0, 0.2);
        border-radius: 0 0 12px 12px;
    }

    .sidebar-logo {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        padding: 5px;
        background-color: #fff;
        border: 2px solid rgba(255, 215, 0, 0.6); /* elegant gold border */
        box-shadow: 0 0 10px rgba(255, 215, 0, 0.5); /* glowing effect */
        transition: box-shadow 0.3s ease-in-out;
    }

        .sidebar-logo:hover {
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.9);
        }


    .submenu {
        border-radius: 0.5rem;
        box-shadow: 2px 2px 6px var(--sidebar-shadow);
        padding: 0.5rem;
    }

    .toggle-sidebar {
        position: fixed;
        top: 5px;
        left: 10px;
        z-index: 10000;
        cursor: pointer;
        background-color: rgba(0, 0, 0, 0.1); /* Semi-transparent background */
        border: none;
        outline: none;
        color: rgba(0, 0, 0, 0.6); /* Semi-transparent icon */
        font-size: 1.2rem;
        padding: 6px 10px;
        border-radius: 5px;
        transition: background-color 0.3s, color 0.3s;
    }

        .toggle-sidebar:hover {
            background-color: rgba(0, 0, 0, 0.2);
            color: rgba(0, 0, 0, 0.9);
        }

        .toggle-sidebar:hover {
            background-color: #f1f1f1;
        }

          #wrapper {
        margin-left: -250px;
         z-index: 9999;
        overflow: hidden;
    }
   
    .wrapper {
        position: fixed;
        height: 100vh;
        width: 0;
        overflow: hidden;
        z-index: 9999;
        top: 0;
        left: 0;
    }

    .footer {
        flex-shrink: 0;
        background-color: var(--sidebar-bg);
        border-top: 1px solid rgba(255, 255, 255, 0.2);
        padding: 10px 15px;
        position: relative;
        z-index: 10;
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        padding-right: 5px;
        padding-bottom: 20px;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }

        .sidebar-content::-webkit-scrollbar {
            display: none; /* Chrome, Safari, Opera */
        }
</style>

<!-- Toggle Button for Sidebar -->
<button class="toggle-sidebar" id="toggleSidebar">
    <i class="fas fa-bars"></i>
</button>

<div id="wrap" class="wrapper">
    <nav id="sidebar">

        <div class="sidebar-header">
            <img src="~/Content/Images/logo/logo.png" class="sidebar-logo" alt="Logo">
        </div>
        <div class="sidebar-content">
            @if (string.Compare(appEnv, "prd", true) != 0)
            {
                <div class="env float-right">
                    <span class="badge badge-danger" title="@appEnv Environment">@appEnv</span>
                    <span class="badge badge-info ml-n1" title="@mode Mode">@mode</span>
                </div>
            }
            <br />
            <ul class="list-unstyled" id="myGroup">
                @if (context.HasPermission("Home.CanView"))
                {
                    <li>
                        <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> <span>Home</span></a>
                    </li>
                }
                @if (context.HasPermission("Product_Inventory.CanView"))
                {
                    <li>
                        <a href="@Url.Action("Index", "Product_Inventory")"><i class="fas fa-warehouse"></i> <span>Inventory</span></a>
                    </li>
                }
                @if (context.HasPermission("Inventory_Entries.CanView"))
                {
                    <li>
                        <a href="@Url.Action("Index", "Inventory_Entries")"><i class="fas fa-list"></i> <span>Inventory Entry</span></a>
                    </li>
                }
                @if (context.HasPermission("Products.CanView"))
                {
                    <li>
                        <a href="@Url.Action("Index", "Products")"><i class="fas fa-gem"></i> <span>Products</span></a>
                    </li>
                }
                @if (context.HasPermission("SalesOrders.CanView"))
                {
                    <li>
                        <a href="@Url.Action("Index", "SalesOrders")"><i class="fas fa-cash-register"></i> <span>Sales Orders</span></a>
                    </li>
                }
                @if (context.HasPermission("SalesOrdersDetails.CanView"))
                {
                    <li>
                        <a href="@Url.Action("Index", "SalesOrdersDetails")"><i class="fas fa-cash-register"></i> <span>Sales Order</span></a>
                    </li>
                }


                @if (context.HasPermission("SalesTypes.CanView") || context.HasPermission("Locations.CanView") || context.HasPermission("ProductType.CanView"))
                {
                    <li>
                        <a href="#masterData-submenu" data-toggle="collapse" aria-expanded="false"><i class="fas fa-cog"></i> <span>Master Data</span></a>
                        <ul class="collapse list-unstyled submenu" id="masterData-submenu" data-parent="#myGroup">
                            @if (context.HasPermission("SalesTypes.CanView"))
                            {
                                <li><a href="@Url.Action("Index", "SalesTypes")">Sales Types</a></li>
                            }
                            @if (context.HasPermission("Locations.CanView"))
                            {
                                <li><a href="@Url.Action("Index", "Locations")">Locations</a></li>
                            }
                            @if (context.HasPermission("ProductType.CanView"))
                            {
                                <li><a href="@Url.Action("Index", "ProductType")">Product Types</a></li>
                            }
                        </ul>
                    </li>
                }
                @if (context.HasPermission("SystemAdministration.CanView") || context.HasPermission("Users.CanView") || context.HasPermission("Roles.CanView"))
                {
                    <li>
                        <a href="#administration-submenu" data-toggle="collapse" aria-expanded="false"><i class="fas fa-cogs"></i> <span>Administration</span></a>
                        <ul class="collapse list-unstyled submenu" id="administration-submenu" data-parent="#myGroup">
                            <li><a href="@Url.Action("Index", "UserMaintenance")">User Maintenance</a></li>
                            <li><a href="@Url.Action("Index", "SystemAdministration")">System Administration</a></li>
                            <li><a href="@Url.Action("Index", "ReportMaintenance")">Report Maintenance</a></li>
                        </ul>
                    </li>
                }
                @if (context.HasPermission("Reports.CanView"))
                {
                    <li>
                        <a href="@Url.Action("Index", "ReportGenerator")"><i class="fas fa-file-invoice"></i> <span>Reports</span></a>
                    </li>
                }
            </ul>
        </div>
        <div class="footer">
            <ul class="list-unstyled">
                <li>
                    <a href="@Url.Action("Profile", "Manage")"><i class="fas fa-user-alt"></i> <span>@User.Identity.Name.Trim().ToLower()</span></a>
                </li>
                <li>
                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <a href="javascript:document.getElementById('logoutForm').submit()"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></a>
                    }
                </li>
            </ul>
        </div>
    </nav>
</div>





<script>
    $(function () {
        $('#sidebar').mouseleave(function () {
            $('ul.collapse').removeClass('show');
        });

        $('#toggleSidebar').on('click', function () {
            $('#sidebar').toggleClass('visible');
            $('#wrap').toggleClass('visible');
        });

        $('#sidebar ul li').hover(function () {
            var submenu = $(this).find('.submenu');
            if (submenu.length) {
                var parentOffset = $(this).offset();
                submenu.css({
                    top: parentOffset.top - $('#sidebar').offset().top
                });
            }
        });
    });
</script>