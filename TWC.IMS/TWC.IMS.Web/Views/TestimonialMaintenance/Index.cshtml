@model IEnumerable<TWC.IMS.Models.TestimonialMaintenance>

@{
    ViewBag.Title = "Testimonial Maintenances";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .highlight {
            background-color: #f5f5a4;
            border: 2px solid #f39c12;
        }

        .editing {
            background-color: #f0f0f0;
        }

        .modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.5);
        }

        .modal-content {
            background-color: #fff;
            margin: 15% auto;
            padding: 20px;
            width: 30%;
            border-radius: 10px;
        }

        .close {
            float: right;
            font-size: 24px;
            cursor: pointer;
        }
    </style>
}

<h2>Testimonial Maintenances</h2>

<button id="addRowBtn" class="btn btn-success mb-2">
    <i class="fas fa-plus"></i> Add New Row
</button>

<table class="table table-bordered" id="testimonialTable">
    <thead>
        <tr>
            <th>Category</th>
            <th>Name</th>
            <th>File Path</th>
            <th style="width: 200px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr data-id="@item.Id" class="existingRow">
                <td class="editable" data-field="Category">@item.Category</td>
                <td class="editable" data-field="Name">@item.Name</td>
                <td>
                    <div class="filePathText" data-field="FilePath">@item.FilePath</div>
                    <input type="file" class="form-control fileInput d-none" />
                </td>
                <td>
                    <button class="btn btn-primary btn-sm saveBtn" disabled>
                        <i class="fas fa-save"></i>
                    </button>
                    <button class="btn btn-info btn-sm editBtn">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="btn btn-danger btn-sm deleteBtn">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                    <button class="btn btn-secondary btn-sm uploadBtn" style="display:none;">
                        <i class="fas fa-upload"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Upload Modal -->
<div id="uploadModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h4>Select file to upload</h4>
        <input type="file" id="modalFileInput" />
        <br /><br />
        <button id="uploadConfirmBtn" class="btn btn-primary">Upload</button>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/js/all.min.js"></script>

    <script>
        let currentUploadRow = null;

        $(document).ready(function () {
            if ($.fn.DataTable) {
                $('#testimonialTable').DataTable({ pageLength: 20, order: [] });
            }

            $('.editable').attr('contenteditable', false);
            $('.saveBtn').prop('disabled', true);

            function highlightEditableFields(row) {
                row.find('.editable').addClass('highlight');
            }

            $(document).on('input', '.editable', function () {
                const row = $(this).closest('tr');
                row.find('.saveBtn').prop('disabled', false);
                highlightEditableFields(row);
            });

            $(document).on('click', '.editBtn', function () {
                const row = $(this).closest('tr');
                row.addClass('editing');
                row.find('.editable').attr('contenteditable', true);
                row.find('.saveBtn').prop('disabled', false);
                row.find('.editBtn').prop('disabled', true);
                row.find('.uploadBtn').show();
                row.find('.editable').first().focus();
            });

            $(document).on('click', '.saveBtn', function () {
                const row = $(this).closest('tr');
                const id = row.data('id') || 0;
                const fileInput = row.find('.fileInput')[0];
                const file = fileInput.files[0];

                const formData = new FormData();
                formData.append("Id", id);
                formData.append("Category", row.find('[data-field="Category"]').text().trim());
                formData.append("Name", row.find('[data-field="Name"]').text().trim());
                formData.append("FilePath", row.find('[data-field="FilePath"]').text().trim());

                if (file) {
                    formData.append("testimonialFile", file);
                }

                const url = id === 0
                    ? '@Url.Action("UploadAndCreate", "TestimonialMaintenance")'
                    : '@Url.Action("UploadAndUpdate", "TestimonialMaintenance")';

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false
                })
                .done(function () {
                    alert('Saved.');
                    location.reload();
                })
                .fail(function () {
                    alert('Error saving.');
                });
            });

            $(document).on('click', '.deleteBtn', function () {
                if (!confirm('Are you sure you want to delete this row?')) return;
                const row = $(this).closest('tr');
                const id = row.data('id');

                if (!id) {
                    row.remove();
                    return;
                }

                $.post('@Url.Action("Delete", "TestimonialMaintenance")', { id: id })
                    .done(function () {
                        row.remove();
                    })
                    .fail(function () {
                        alert('Error deleting.');
                    });
            });

            $('#addRowBtn').click(function () {
                const newRow = `
                    <tr data-id="0" class="newRow editing">
                        <td class="editable" data-field="Category" contenteditable="true"></td>
                        <td class="editable" data-field="Name" contenteditable="true"></td>
                        <td>
                            <div class="filePathText" data-field="FilePath"></div>
                            <input type="file" class="form-control fileInput d-none" />
                        </td>
                        <td>
                            <button class="btn btn-primary btn-sm saveBtn">
                                <i class="fas fa-save"></i>
                            </button>
                            <button class="btn btn-danger btn-sm deleteBtn">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                            <button class="btn btn-info btn-sm editBtn" disabled>
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-secondary btn-sm uploadBtn">
                                <i class="fas fa-upload"></i>
                            </button>
                        </td>
                    </tr>`;
                $('#testimonialTable tbody').prepend(newRow);
                highlightEditableFields($('#testimonialTable tbody tr').first());
            });

            $(document).on('click', '.uploadBtn', function () {
                currentUploadRow = $(this).closest('tr');
                $('#modalFileInput').val('');
                $('#uploadModal').show();
            });

            $('.close').on('click', function () {
                $('#uploadModal').hide();
            });

            $('#uploadConfirmBtn').on('click', function () {
                const fileInput = $('#modalFileInput')[0];
                const file = fileInput.files[0];
                if (!file) {
                    alert('Please select a file.');
                    return;
                }

                const fileName = file.name;
                const filePath = '/' + fileName;

                currentUploadRow.find('[data-field="Name"]').text(fileName);
                currentUploadRow.find('[data-field="FilePath"]').text(filePath).removeClass('d-none');
                currentUploadRow.find('.fileInput')[0].files = fileInput.files;
                currentUploadRow.find('.saveBtn').prop('disabled', false);

                $('#uploadModal').hide();
            });

            $('#testimonialTable').on('focus', '.editable', function () {
                const row = $(this).closest('tr');
                if (row.hasClass('newRow') || row.hasClass('editing')) {
                    $(this).addClass('highlight');
                }
            });

            $('#testimonialTable').on('blur', '.editable', function () {
                $(this).removeClass('highlight');
            });
        });
    </script>
}
