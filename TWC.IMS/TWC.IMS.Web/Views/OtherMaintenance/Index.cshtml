@model IEnumerable<TWC.IMS.Models.OtherMaintenance>

@{
    ViewBag.Title = "Other Maintenances";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productList = ViewBag.ProductList as List<SelectListItem>;
}

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        .action-icon {
            cursor: pointer;
            margin-right: 8px;
            font-size: 1.1rem;
        }

            .action-icon.disabled {
                pointer-events: none;
                opacity: 0.5;
            }

        .highlight {
            background-color: #f5f5a4;
            border: 2px solid #f39c12;
        }

        .modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.5);
        }

        .modal-content {
            background-color: #fff;
            margin: 15% auto;
            padding: 20px;
            width: 30%;
            border-radius: 10px;
        }

        .close {
            float: right;
            font-size: 24px;
            cursor: pointer;
        }
        .col-product {
            width: 200px;
            min-width: 180px;
        }

        .col-actions {
            width: 180px;
            min-width: 200px;
        }
        .col-file {
            width: 300px;
            min-width: 200px;
            font-size: 0.85rem;
            word-wrap: break-word;
            white-space: normal;
        }

    </style>
}

<h2>Other Maintenances</h2>

<button id="addRowBtn" class="btn btn-success mb-2">Add New Row</button>

<table class="table table-bordered" id="maintenanceTable">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>File</th>
            <th class="col-product">Product</th>
            <th class="col-actions">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr data-id="@item.Id" class="existingRow">
                <td class="editable" data-field="Name">@item.Name</td>
                <td class="editable" data-field="Category">@item.Category</td>
                <td>
                    <div class="filePathText col-file" data-field="FilePath">@item.FilePath</div>
                    <input type="file" class="form-control fileInput d-none" />
                </td>
                <td>
                    <select class="form-control productSelect" data-field="ProductMasterId" disabled>
                        @foreach (var product in productList)
                        {
                            <option value="@product.Value" @(item.ProductMasterId.ToString() == product.Value ? "selected" : "")>
                                @product.Text
                            </option>
                        }
                    </select>
                </td>
                <td>
                    <button class="btn btn-primary btn-sm saveBtn" disabled>
                        <i class="fas fa-save"></i>
                    </button>
                    <button class="btn btn-info btn-sm editBtn">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="btn btn-danger btn-sm deleteBtn">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                    <button class="btn btn-secondary btn-sm uploadBtn" style="display:none;">
                        <i class="fas fa-upload"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Upload Modal -->
<div id="uploadModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h4>Select file to upload</h4>
        <input type="file" id="modalFileInput" />
        <br /><br />
        <button id="uploadConfirmBtn" class="btn btn-primary">Upload</button>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        const productList = @Html.Raw(Json.Encode(productList));
        let currentUploadRow = null;

        $(function () {
            $('.editable').attr('contenteditable', false);
            $('.saveBtn').prop('disabled', true);

            function highlightEditableFields(row) {
                row.find('.editable').addClass('highlight');
                row.find('.productSelect').addClass('highlight');
            }

            $(document).on('click', '.editBtn', function () {
                const row = $(this).closest('tr');
                row.find('.editable').attr('contenteditable', true);
                row.find('.productSelect').prop('disabled', false);
                row.find('.uploadBtn').show();
                highlightEditableFields(row);
            });

            $(document).on('input', '.editable', function () {
                const row = $(this).closest('tr');
                row.find('.saveBtn').prop('disabled', false);
                highlightEditableFields(row);
            });

            $(document).on('change', '.productSelect', function () {
                const row = $(this).closest('tr');
                row.find('.saveBtn').prop('disabled', false);
                $(this).addClass('highlight');
            });

            $(document).on('click', '.uploadBtn', function () {
                currentUploadRow = $(this).closest('tr');
                $('#modalFileInput').val('');
                $('#uploadModal').show();
            });

            $('.close').on('click', function () {
                $('#uploadModal').hide();
            });

            $('#uploadConfirmBtn').on('click', function () {
                const fileInput = $('#modalFileInput')[0];
                const file = fileInput.files[0];
                if (!file) {
                    alert('Please select a file.');
                    return;
                }

                const fileName = file.name;
                const filePath = '/' + fileName;

                currentUploadRow.find('[data-field="Name"]').text(fileName);
                currentUploadRow.find('[data-field="FilePath"]').text(filePath).removeClass('d-none');
                currentUploadRow.find('.fileInput').prop('files', fileInput.files);
                currentUploadRow.find('.saveBtn').prop('disabled', false);

                $('#uploadModal').hide();
            });

            $(document).on('click', '.saveBtn', function () {
                const row = $(this).closest('tr');
                const id = row.data('id') || 0;
                const fileInput = row.find('.fileInput')[0];
                const file = fileInput.files[0];

                const formData = new FormData();
                formData.append("Id", id);
                formData.append("Name", row.find('[data-field="Name"]').text().trim());
                formData.append("Category", row.find('[data-field="Category"]').text().trim());
                formData.append("FilePath", row.find('[data-field="FilePath"]').text().trim());
                formData.append("ProductMasterId", row.find('.productSelect').val());

                if (file) {
                    formData.append("othersFile", file);
                }

                const url = id === 0
                    ? '@Url.Action("UploadAndCreate", "OtherMaintenance")'
                    : '@Url.Action("UploadAndUpdate", "OtherMaintenance")';

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false
                })
                .done(function () {
                    alert('Saved.');
                    location.reload();
                })
                .fail(function () {
                    alert('Error saving.');
                });
            });

            $(document).on('click', '.deleteBtn', function () {
                if (!confirm('Are you sure you want to delete this row?')) return;

                const row = $(this).closest('tr');
                const id = row.data('id');

                if (!id || id === 0) {
                    row.remove();
                    return;
                }

                $.post('@Url.Action("Delete", "OtherMaintenance")', { id: id })
                    .done(function () {
                        row.remove();
                    })
                    .fail(function () {
                        alert('Error deleting.');
                    });
            });

            $('#addRowBtn').click(function () {
                const productOptions = productList.map(p =>
                    `<option value="${p.Value}">${p.Text}</option>`
                ).join('');

                const newRow = `
                    <tr data-id="0" class="newRow">
                        <td class="editable" data-field="Name" contenteditable="true"></td>
                        <td class="editable" data-field="Category" contenteditable="true"></td>
                        <td>
                            <div class="filePathText" data-field="FilePath"></div>
                            <input type="file" class="form-control fileInput d-none" />
                        </td>
                        <td>
                            <select class="form-control productSelect" data-field="ProductMasterId">
                                ${productOptions}
                            </select>
                        </td>
                        <td>
                            <button class="btn btn-primary btn-sm saveBtn">
                                <i class="fas fa-save"></i>
                            </button>
                            <button class="btn btn-danger btn-sm deleteBtn">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                            <button class="btn btn-secondary btn-sm uploadBtn">
                                <i class="fas fa-upload"></i>
                            </button>
                        </td>
                    </tr>`;
                $('#maintenanceTable tbody').prepend(newRow);
                highlightEditableFields($('#maintenanceTable tbody tr').first());
            });

            $('#maintenanceTable').on('blur', '.editable', function () {
                $(this).removeClass('highlight');
            });
        });
    </script>
}
