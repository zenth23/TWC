@model IEnumerable<TWC.IMS.Models.OtherMaintenance>

@{
    ViewBag.Title = "Other Maintenances";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productList = ViewBag.ProductList as List<SelectListItem>;
}

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        .action-icon {
            cursor: pointer;
            margin-right: 8px;
            font-size: 1.1rem;
        }

            .action-icon.disabled {
                pointer-events: none;
                opacity: 0.5;
            }

        .highlight {
            background-color: #f5f5a4;
            border: 2px solid #f39c12;
        }
    </style>
}

<h2>Other Maintenances</h2>

<button id="addRowBtn" class="btn btn-success mb-2">Add New Row</button>

<table class="table table-bordered" id="maintenanceTable">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>FilePath</th>
            <th>Product</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr data-id="@item.Id" class="existingRow">
                <td class="editable" data-field="Name">@item.Name</td>
                <td class="editable" data-field="Category">@item.Category</td>
                <td class="editable" data-field="FilePath">@item.FilePath</td>
                <td>
                    <select class="form-control productSelect" data-field="ProductMasterId" disabled>
                        @foreach (var product in productList)
                        {
                            <option value="@product.Value" @(item.ProductMasterId.ToString() == product.Value ? "selected" : "")>
                                @product.Text
                            </option>
                        }
                    </select>
                </td>
                <td>
                    <button class="btn btn-primary btn-sm saveBtn" disabled>
                        <i class="fas fa-save"></i> Save
                    </button>
                    <button class="btn btn-info btn-sm editBtn">
                        <i class="fas fa-edit"></i> Edit
                    </button>
                    <button class="btn btn-danger btn-sm deleteBtn">
                        <i class="fas fa-trash-alt"></i> Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        const productList = @Html.Raw(Json.Encode(productList));

        $(function () {
            $('.editable').attr('contenteditable', false);
            $('.saveBtn').addClass('disabled');

            function highlightEditableFields(row) {
                row.find('.editable').each(function () {
                    $(this).addClass('highlight');
                });
                row.find('.productSelect').addClass('highlight');
            }

            $(document).on('click', '.editBtn', function () {
                const row = $(this).closest('tr');
                row.find('.editable').attr('contenteditable', true);
                row.find('.productSelect').prop('disabled', false);
                highlightEditableFields(row);
            });

            $(document).on('input', '.editable', function () {
                const row = $(this).closest('tr');
                row.find('.saveBtn').each(function () {
                    $(this).removeAttr('disabled').removeClass('disabled');
                });
                highlightEditableFields(row);
            });

            // ✅ Fix for dropdown change not enabling Save button
            $(document).on('change', '.productSelect', function () {
                const row = $(this).closest('tr');
                row.find('.saveBtn').each(function () {
                    $(this).removeAttr('disabled').removeClass('disabled');
                });
                $(this).addClass('highlight');
            });

            $(document).on('click', '.saveBtn', function () {
                if ($(this).hasClass('disabled') || $(this).attr('disabled')) return;

                const row = $(this).closest('tr');
                const id = row.data('id') || 0;

                const data = {
                    Id: id,
                    Name: row.find('[data-field="Name"]').text().trim(),
                    Category: row.find('[data-field="Category"]').text().trim(),
                    FilePath: row.find('[data-field="FilePath"]').text().trim(),
                    ProductMasterId: row.find('.productSelect').val()
                };

                const url = id === 0
                    ? '@Url.Action("Create", "OtherMaintenance")'
                    : '@Url.Action("Update", "OtherMaintenance")';

                $.post(url, data)
                    .done(function () {
                        alert('Saved.');
                        if (id === 0) location.reload();
                        else {
                            row.find('.editable').attr('contenteditable', false).removeClass('highlight');
                            row.find('.productSelect').prop('disabled', true).removeClass('highlight');
                            row.find('.saveBtn').attr('disabled', true).addClass('disabled');
                        }
                    })
                    .fail(function () {
                        alert('Error saving.');
                    });
            });

            $(document).on('click', '.deleteBtn', function () {
                if (!confirm('Are you sure you want to delete this row?')) return;

                const row = $(this).closest('tr');
                const id = row.data('id');

                if (id === 0 || !id) {
                    row.remove();
                    return;
                }

                $.post('@Url.Action("Delete", "OtherMaintenance")', { id: id })
                    .done(function () {
                        row.remove();
                    })
                    .fail(function () {
                        alert('Error deleting.');
                    });
            });

            $('#addRowBtn').click(function () {
                const productOptions = productList.map(p =>
                    `<option value="${p.Value}">${p.Text}</option>`
                ).join('');

                const newRow = `
                    <tr data-id="0" class="newRow">
                        <td class="editable" data-field="Name" contenteditable="true"></td>
                        <td class="editable" data-field="Category" contenteditable="true"></td>
                        <td class="editable" data-field="FilePath" contenteditable="true"></td>
                        <td>
                            <select class="form-control productSelect" data-field="ProductMasterId">
                                ${productOptions}
                            </select>
                        </td>
                        <td>
                            <i class="fas fa-save text-primary action-icon saveBtn" title="Save"></i>
                            <i class="fas fa-trash text-danger action-icon deleteBtn" title="Delete"></i>
                        </td>
                    </tr>`;
                $('#maintenanceTable tbody').prepend(newRow);

                const row = $('#maintenanceTable tbody tr').first();
                highlightEditableFields(row);
            });

            $('#maintenanceTable').on('blur', '.editable', function () {
                $(this).removeClass('highlight');
            });
        });
    </script>
}
