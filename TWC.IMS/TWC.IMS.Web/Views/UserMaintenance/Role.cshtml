@model TWC.IMS.Web.Models.RoleViewModel

@{
    ViewBag.Title = "Role Maintenance";
}

<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <h2><span class="fas fa-users-cog"></span> @ViewBag.Title</h2>
    </div>
</div>
<hr />
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
    @using (Html.BeginForm("detailsrole", "maintenance", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.Partial("_ValidationSummary")

            @if (ViewBag.Mode == "EDIT")
            {
                <h3>Role</h3>
            }
            else
            {
                <h3>New Role</h3>
            }

            @Html.HiddenFor(a => a.Id)

            <div class="form-group row">
                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
                <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", data_val_required = "The Name field is required.", data_val = "true", data_val_length_max = "255", data_val_length = "The field Name must be a string with a maximum length of 255." } })
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group row">
                @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
                <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                    @Html.TextAreaFor(model => model.Description, 3, 20, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>
            </div>
            @if ((bool)ViewBag.IsCurrentUserAdmin)
            {
                <div class="form-group row">
                    @Html.LabelFor(model => model.IsAdmin, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
                    <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                        <div class="checkbox">
                            @Html.Kendo().CheckBoxFor(model => model.IsAdmin).Label("")
                        </div>
                        @Html.ValidationMessageFor(model => model.IsAdmin, "", new { @class = "text-danger" })
                    </div>
                </div>
            }
            <div class="form-group row">
                @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
                <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                    <div class="checkbox">
                        @Html.Kendo().CheckBoxFor(model => model.IsActive).Label("").HtmlAttributes(new { data_toggle = "popover", data_placement = "left", title = "WARNING", data_content = "When set to inactive, all users under this role will not be able to login." })
                    </div>
                    @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                </div>
            </div>
            @if (ViewBag.Mode == "EDIT")
            {
                <hr />
                <div class="form-group row">
                    @Html.LabelFor(model => model.CreatedBy, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
                    <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                        @Html.DisplayFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>

                <div class="form-group row">
                    @Html.LabelFor(model => model.ModifiedBy, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
                    <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                        @Html.DisplayFor(model => model.ModifiedBy, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            }
            <hr />
            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                    <ul class="header-text-button-container">
                        <li><h3>Accesses</h3></li>
                    </ul>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                    @{
                        Html.RenderAction("GetModuleAccessesByRolePartialView", "AccessModules", new { roleid = Model == null ? null : Model.Id });
                    }
                </div>
            </div>
            <hr />
            <div class="form-group">
                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                    <a href="~/maintenance#roles" class="btn btn-outline-secondary">Cancel</a>
                    <input type="button" value="Clear" class="btn btn-outline-secondary" id="btnReset" />
                    <input type="submit" value="Save" class="btn btn-secondary float-right" name="ACTION:@ViewBag.Mode" />
                    @if ((bool)ViewBag.IsAutoLogoutEnabled == true && ViewBag.Mode == "EDIT")
                    {
                        <button type="button" class="btn text-warning float-right mr-3" style="cursor:pointer;"
                                data-toggle="popover" 
                                data-placement="left" 
                                title="WARNING"
                                data-content="Auto-logout of all users under this role is enabled.">
                            <span class='fas fa-exclamation-triangle'></span>
                        </button>
                    }
                </div>
            </div>
            @if (ViewBag.Mode == "EDIT")
            {
                <hr />
                <div class="row">
                    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                        @{Html.RenderAction("RoleUsers", "UserMaintenance", new { roleid = Model.Id }); }
                    </div>
                </div>
                            }
        </div>
                            }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/Scripts/application/role.js?v=" + DateTime.Now.Ticks)
}