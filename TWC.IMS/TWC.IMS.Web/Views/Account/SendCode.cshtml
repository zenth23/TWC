@model TWC.IMS.Web.Models.SendCodeViewModel
@{
    ViewBag.Title = "Send Verification Code";
}

<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <h2><span class="fas fa-paper-plane"></span> @ViewBag.Title</h2>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        @using (Html.BeginForm("SendCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("rememberMe", @Model.RememberMe)
            <div class="form-group">
                <label for="SelectedProvider" class="col-sm-4 col-md-4 col-lg-4 col-xl-4 control-label">Select Two-Factor Authentication Provider</label>
                <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                    @Html.DropDownListFor(model => model.SelectedProvider, Model.Providers, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                    <input type="submit" value="Submit" class="btn btn-secondary" />
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                    <a href="~/account/login">Back</a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
