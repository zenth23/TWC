@model IEnumerable<TWC.IMS.Models.VideoMaintenance>

@{
    ViewBag.Title = "Video Maintenances";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        .highlight {
            background-color: #f5f5a4;
            border: 2px solid #f39c12;
        }

        /* Optionally, highlight edited rows */
        .editing {
            background-color: #f0f0f0;
        }
    </style>
}

<h2>Video Maintenances</h2>

<button id="addRowBtn" class="btn btn-success mb-2">
    <i class="fas fa-plus"></i> Add New Row
</button>

<table class="table table-bordered" id="maintenanceTable">
    <thead>
        <tr>
            <th>Category</th>
            <th>Name</th>
            <th>File Path</th>
            @*<th>Created By</th>
            <th>Created</th>*@
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr data-id="@item.Id" class="existingRow">
                <td class="editable" data-field="Category">@item.Category</td>
                <td class="editable" data-field="Name">@item.Name</td>
                <td class="editable" data-field="FilePath">@item.FilePath</td>
                @*<td>@item.CreatedBy</td>
                <td>@item.Created.ToString("g")</td>*@
            <td>
                <button class="btn btn-primary btn-sm saveBtn" disabled>
                    <i class="fas fa-save"></i>Save
                </button>
                <button class="btn btn-info btn-sm editBtn">
                    <i class="fas fa-edit"></i> Edit
                </button>
                <button class="btn btn-danger btn-sm deleteBtn">
                    <i class="fas fa-trash-alt"></i>Delete
                </button>
            </td>
            </tr>
        }
    </tbody>
</table>

@section scripts {
    <!-- Load jQuery before DataTables -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Load DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <!-- Load FontAwesome -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/js/all.min.js"></script>

    <script>
        $(document).ready(function () {
            // Initialize DataTable after the page loads
            if (typeof $.fn.DataTable === 'function') {
                $('#maintenanceTable').DataTable({
                    "pageLength": 20,
                    "order": []
                });
            } else {
                console.error("DataTables plugin failed to load.");
            }

            // Make cells editable and highlight them when editing
            $('.editable').attr('contenteditable', false);
            $('.saveBtn').prop('disabled', true);

            function highlightEditableFields(row) {
                row.find('.editable').each(function () {
                    $(this).addClass('highlight');
                });
            }

            // Input event to handle editable cells
            $(document).on('input', '.editable', function () {
                var row = $(this).closest('tr');
                row.find('.saveBtn').prop('disabled', false); // Enable save button
                highlightEditableFields(row);
            });

            // Save the changes via AJAX
            $(document).on('click', '.saveBtn', function () {
                var row = $(this).closest('tr');
                var id = row.data('id') || 0;
                var data = {
                    Id: id,
                    Category: row.find('[data-field="Category"]').text().trim(),
                    Name: row.find('[data-field="Name"]').text().trim(),
                    FilePath: row.find('[data-field="FilePath"]').text().trim()
                };

                var url = id === 0
                    ? '@Url.Action("Create", "VideoMaintenance")'
                    : '@Url.Action("Update", "VideoMaintenance")';

                $.post(url, data)
                    .done(function () {
                        alert('Saved.');
                        if (id === 0) location.reload(); // Refresh the page if it’s a new row
                        else row.find('.saveBtn').prop('disabled', true);
                    })
                    .fail(function () {
                        alert('Error saving.');
                    });
            });

            // Delete row
            $(document).on('click', '.deleteBtn', function () {
                if (!confirm('Are you sure you want to delete this row?')) return;

                var row = $(this).closest('tr');
                var id = row.data('id');

                if (id === 0 || !id) {
                    row.remove();
                    return;
                }

                $.post('@Url.Action("Delete", "VideoMaintenance")', { id: id })
                    .done(function () {
                        row.remove();
                    })
                    .fail(function () {
                        alert('Error deleting.');
                    });
            });

            // Edit row
            $(document).on('click', '.editBtn', function () {
                var row = $(this).closest('tr');
                var id = row.data('id');
                row.addClass('editing'); // Add an "editing" class to highlight the row

                // Enable editing on the cells
                row.find('.editable').attr('contenteditable', true);
                row.find('.saveBtn').prop('disabled', false); // Enable save button
                row.find('.editBtn').prop('disabled', true); // Disable edit button while editing

                // Focus on the first editable cell for better UX
                row.find('.editable').first().focus();
            });

            // Add new empty row
            $('#addRowBtn').click(function () {
                var newRow = `
                    <tr data-id="0" class="newRow">
                        <td class="editable" data-field="Category" contenteditable="true"></td>
                        <td class="editable" data-field="Name" contenteditable="true"></td>
                        <td class="editable" data-field="FilePath" contenteditable="true"></td>
                        <td>system</td>
                        <td>${new Date().toLocaleString()}</td>
                        <td>
                            <button class="btn btn-primary btn-sm saveBtn">
                                <i class="fas fa-save"></i>
                            </button>
                            <button class="btn btn-danger btn-sm deleteBtn">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                            <button class="btn btn-info btn-sm editBtn">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                        </td>
                    </tr>`;
                $('#maintenanceTable tbody').prepend(newRow);
                var row = $('#maintenanceTable tbody tr').first();
                highlightEditableFields(row);
            });

            // Enable or disable highlight class based on whether the row is new or editing
            $('#maintenanceTable').on('focus', '.editable', function () {
                var row = $(this).closest('tr');
                if (row.hasClass('newRow') || row.hasClass('editing')) {
                    $(this).addClass('highlight');
                }
            });

            // Remove highlight when focus is lost
            $('#maintenanceTable').on('blur', '.editable', function () {
                $(this).removeClass('highlight');
            });
        });
    </script>
}
