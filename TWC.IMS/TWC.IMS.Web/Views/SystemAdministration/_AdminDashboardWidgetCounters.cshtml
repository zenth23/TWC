
<div class="col-3 pr-1">
    @*
        logged errors counter
        card
    *@
    <div class="card" style="height:125px;">
        <div class="row card-body">
            <div class="col-8 pr-0">
                <span class="card-title text-muted">Total Logs</span>
                <div class="col pl-0">
                    <span id="totalLoggedErrors" class="wrap-text" style="font-size:3rem;">0</span>
                </div>
            </div>
            <div class="col-3 px-0">
                <span class="fas fa-exclamation-triangle float-right text-muted" style="font-size:2rem;"></span>
            </div>
        </div>
    </div>
</div>
<div class="col-3 px-1">
    @*
        logged users counter
        card
    *@
    <div class="card" style="height:125px;">
        <div class="row card-body">
            <div class="col-8 pr-0">
                <span class="card-title text-muted">Total Logged Users</span>
                <div class="col pl-0">
                    <span id="totalLoggedUsers" class="wrap-text" style="font-size:3rem;">0</span>
                </div>
            </div>
            <div class="col-3 px-0">
                <span class="fas fa-users float-right text-muted" style="font-size:2rem;"></span>
            </div>
        </div>
    </div>
</div>
<div class="col-3 px-1">
    @Html.Partial("_AdminDashboardWidgetCountersErrorTrendChart")
</div>
