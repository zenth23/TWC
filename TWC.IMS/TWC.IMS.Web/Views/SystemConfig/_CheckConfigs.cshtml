
<div class="modal" tabindex="-1" id="modalConfigsList" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title new">Required Configs</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12 col-lg-12 col-xl-12">
                        <p>Here's the list of configs required for the system to run expectedly:</p>
                        @(Html.Kendo().Grid<TWC.IMS.Models.HelperModels.SystemConfigCheckModel>()
                              .Name("gridConfigsList")
                              .Columns(column =>
                              {
                                  column.Bound(col => col.Status).Title("").Width(30).ClientTemplate("#if(Status=='false'){#<span class='fas fa-times text-danger' title='Failed'></span>#}else{#<span class='fas fa-check text-success' title='OK'></span>#}#");
                                  column.Bound(col => col.Name).Width(300);
                                  column.Bound(col => col.Value).Width(200);
                                  column.Bound(col => col.Remarks).Width(120);
                              })
                              .Resizable(r => r.Columns(true))
                              .Scrollable(s => s.Height(400))
                              .Selectable(s => s.Mode(GridSelectionMode.Single))
                              .DataSource(ds => {
                                  ds.Ajax()
                                    .Read(r => r.Action("ReadRequiredConfigs","systemconfig"));
                              })
                        )
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Back</button>
                <button type="button" class="btn btn-secondary" id="btnRefreshChecklistGrid">Refresh</button>
            </div>
        </div>
    </div>
</div>