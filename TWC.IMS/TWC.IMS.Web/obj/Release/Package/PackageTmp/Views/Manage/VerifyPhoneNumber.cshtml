@model TWC.IMS.Web.Models.VerifyPhoneNumberViewModel
@{
    ViewBag.Title = "Verify Phone Number";
}

<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <h2><span class="fas fa-user-shield"></span> @ViewBag.Title</h2>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        @using (Html.BeginForm("VerifyPhoneNumber", "Manage", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("sid", @Model.Sid)
            @Html.Hidden("phoneNumber", @Model.PhoneNumber)
            
            @Html.Partial("_ValidationSummary")

            if (!this.ViewContext.ViewData.ModelState.Where(x => x.Key == "").Any())
            {
                <div class="alert alert-warning">Verification code has been sent to your phone number. Enter the code below.</div>
            }

            <div class="form-group">
                @Html.LabelFor(m => m.Code, new { @class = "col-sm-2 col-md-2 col-lg-2 col-xl-2 control-label" })
                <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                    @Html.TextBoxFor(m => m.Code, new { @class = "form-control" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                    <input type="submit" class="btn btn-secondary" value="Submit" />
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
