@model TWC.IMS.Web.Models.TotpBasedAuthenticatorViewModel
@{
    ViewBag.Title = "Disable 2FA";
}

<div class="row">
    @if (!string.IsNullOrWhiteSpace(TempData["ERROR_MESSAGE"] as string))
    {
        <div class="alert alert-danger">
            <span>@TempData["ERROR_MESSAGE"]</span>
        </div>
    }
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <h2><span class="fas fa-id-badge"></span> @ViewBag.Title</h2>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-8">
        @using (Html.BeginForm("DisableTwoFactorAuthentication", "Manage", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.Partial("_ValidationSummary")
            @Html.HiddenFor(m => m.Provider)
            <div class="form-group">
                @Html.LabelFor(m => m.Code, new { @class = "col-md-2 control-label" })
                <div class="col-md-10">
                    @Html.TextBoxFor(m => m.Code, new { @class = "form-control", autocomplete = "off" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" class="btn btn-secondary" value="Disable" />
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                    <a href="~/manage/sendcode">Back</a>
                </div>
            </div>
        }
    </div>
</div>