@model IEnumerable<Smits.Etg.O365BillingSystem.WinAuth.Web.Models.RecentActivitiesViewModel>

<div class="card">
    <div class="card-header">
        My Recent Activities
    </div>
    <div class="card-body py-2" style="height:487px;overflow: scroll;">
        <ul class="list-group list-group-flush">
            @{
                if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <li class="list-group-item px-0 py-1">
                            <h5 class="mb-0">@item.Activity</h5>
                            <span class="text-muted">@item.Time</span>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item px-0 py-1">
                        No activities yet
                    </li>
                }
            }
            @*<li class="list-group-item px-0 py-1">
                <h5 class="mb-0">Home > Index</h5>
                <span class="text-muted">2mins ago</span>
            </li>
            <li class="list-group-item px-0 py-1">
                <h5 class="mb-0">Reports > Index</h5>
                <span class="text-muted">1hr ago</span>
            </li>*@
        </ul>
    </div>
</div>