@model IEnumerable < TWC.IMS.Web.Models.ProductTypeViewModel>

@{
    ViewBag.Title = "Product Types Editor";
}

<style>
    .center {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
    }
    .image-holder {
        height: 25px;
        width: 500px
    }

    .ProductType-img {
        height: 100%; 
        width: 100%; 
        object-fit: contain;
        border: 1px solid black 
    }
</style>
@Html.AntiForgeryToken()

<div class="row">
    <div class="col-sm-9 col-md-9 col-lg-9 col-xl-9">
        <ul class="header-text-button-container">
       
            <li>
                <h2 class="mt-1">@ViewBag.Title</h2>
            </li>
        </ul>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-lg-12">

        @(Html.Kendo().Grid(Model)
                    .Name("gridProductType")
                    .Columns(columns =>
                    {
                        columns.Command(command =>
                        {
                            if (this.Context.HasPermission("ProductType.CanEdit"))
                            {
                                command.Edit().IconClass("fas fa-pen").Text(" ").HtmlAttributes(new { title = "Edit" });
                            }
                            if (this.Context.HasPermission("ProductType.CanDelete"))
                            {
                                command.Custom("Delete").IconClass("fas fa-trash").Text(" ").HtmlAttributes(new { title = "Delete" }).Click("ProductType.editor.events.onGridDeleteClick");
                            }
                        }).Width(145).HtmlAttributes(new { @data_id = "#=Id#" });
                        columns.Bound(p => p.Code).Width(150);
                        columns.Bound(p => p.Description).Width(150);
                        columns.Bound(p => p.Created).ClientTemplate("#= Created ? kendo.toString(kendo.parseDate(Created), 'dd-MMM-yyyy') : '' #").Width(150);
                        columns.Bound(p => p.CreatedBy).Width(150);
                        columns.Bound(p => p.Modified).ClientTemplate("#= Modified ? kendo.toString(kendo.parseDate(Modified), 'dd-MMM-yyyy') : '' #").Width(150);
                        columns.Bound(p => p.ModifiedBy).Width(150);
                    })
                    .ToolBar(toolbar => 
                    {
                        if (this.Context.HasPermission("ProductType.CanAdd"))
                        {
                            toolbar.Create().IconClass("fas fa-plus").Text("New");
                        }
                    })
                    .Editable(editable => editable.Mode(GridEditMode.InLine))
                    .Pageable(p => p.Refresh(true))
                    .Filterable()
                    .Resizable(r => r.Columns(true))
                    .Sortable()
                    .Scrollable(s => s.Height(320))
                    .Events(events =>
                    {
                        events.Edit("ProductType.common.onEdit");
                    })
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .PageSize(20)
                        .Events(events =>
                        {
                            events.Error("ProductType.common.errorHandler").RequestEnd("ProductType.common.onRequestEnd");
                        })
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Created).Editable(false);
                            model.Field(p => p.CreatedBy).Editable(false);
                            model.Field(p => p.Modified).Editable(false);
                            model.Field(p => p.ModifiedBy).Editable(false);
                        })
                        .Create(update => update.Action("SaveProductType", "ProductType"))
                        .Read(read => read.Action("GetProductType", "ProductType"))
                        .Update(update => update.Action("SaveProductType", "ProductType"))
                        .Destroy(update => update.Action("DeleteProductType", "ProductType"))
                    )
        )
    </div>
    <input type="hidden" id="hiddenSelectedProductType" />

</div>


<!-- Modal -->


@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/Scripts/application/common-helper.js")
    @Scripts.Render("~/Scripts/application/ProductType.js")

}

<script>
    $(function () {
        ProductType.initialize()
    })
</script>
