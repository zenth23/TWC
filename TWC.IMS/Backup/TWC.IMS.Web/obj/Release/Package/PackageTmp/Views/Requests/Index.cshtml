@model IEnumerable<TWC.IMS.Web.Models.RequestViewModel >
@{
    ViewBag.Title = "Requests";
}

<style>
    .k-grid td {
        white-space: nowrap !important;
    }
</style>

@Html.AntiForgeryToken()

<div class="row">
    <div class="col-sm-9 col-md-9 col-lg-9 col-xl-9">
        <ul class="header-text-button-container">
            <li>
                <a href="~/requests/details" class="btn btn-sm btn-primary" id="btnCreateNew" title="New"><span class="fas fa-plus"></span></a>
            </li>
            <li>
                <h2 class="mt-1">@ViewBag.Title</h2>
            </li>
        </ul>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        @(Html.Kendo().Grid(Model)
              .Name("gridRequests")
              .Columns(column =>
              {
                  column.Command(c =>
                  {
                      c.Custom("Edit").Text("<span class='fas fa-pen'></span>").HtmlAttributes(new { title = "Edit", data_cname = "requests", data_propname = "UniqueKey" }).Click("application.grid.editItem");

                      //if (this.Context.HasPermission("Requests.CanEdit"))
                      //{
                      //    c.Custom("Edit").Text("<span class='fas fa-pen'></span>").HtmlAttributes(new { title = "Edit", data_cname = "requests", data_propname = "UniqueKey" }).Click("application.grid.editItem");
                      //}
                      //if (this.Context.HasPermission("Requests.CanDelete"))
                      //{
                      //    c.Custom("Delete").Text("<span class='fas fa-trash'></span>").HtmlAttributes(new { title = "Delete", data_cname = "requests", data_propname = "Name", data_propid = "UniqueKey" }).Click("application.grid.deleteItem");
                      //}
                  }).Width(60).HtmlAttributes(new { @class = "k-alt command" });
                  column.Bound(c => c.Name).Width(300);
                  column.Bound(c => c.Description).Width(600);
                  column.Bound(c => c.StrStatus).Width(300);
                  column.Bound(c => c.CreatedOn).Width(150);
                  column.Bound(c => c.CreatedBy).Width(150);
                  column.Bound(c => c.ModifiedOn).Width(150);
                  column.Bound(c => c.ModifiedBy).Width(150);
              })
              .Filterable()
              .Pageable(p => p.Refresh(true)
                              .PageSizes(true)
                              .PageSizes(new int[] { 15, 30, 50, 100 })
                              .Input(true)
                              .ButtonCount(5))
              .Selectable(s => s.Mode(GridSelectionMode.Single))
              .Sortable(s => s.SortMode(GridSortMode.SingleColumn))
              .Scrollable(s => s.Height(400))
              .Resizable(r => r.Columns(true))
              .DataSource(ds =>
              {
                  ds.Ajax()
                  .PageSize(15)
                  .Read(r => r.Action("ReadRequests", "Requests"))
                  .Model(m => m.Id(c => c.Id));
              }))
    </div>
</div>
