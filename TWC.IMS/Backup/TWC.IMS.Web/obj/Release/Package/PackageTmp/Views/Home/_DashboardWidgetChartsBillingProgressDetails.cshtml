@model IEnumerable<TWC.IMS.Models.ChartModels.BillingRequestsBillingProgressModel>

<div class="modal" id="modalBillingProgressDetails">
    <div class="modal-dialog modal-lg" style="max-width:95vw;max-height:95vh;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Billing Progress Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-4 pr-1">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">@ViewBag.UnbilledStatusName <span class="badge badge-warning" id="gridUnbilledCount">0</span></h5>
                                @(Html.Kendo().Grid(Model)
                                      .Name("gridUnbilled")
                                      .Columns(column =>
                                      {
                                          column.Bound(b => b.BusinessUnitName);
                                      })
                                      .Filterable()
                                      .Scrollable()
                                      .Resizable(r => r.Columns(true))
                                      .Sortable(s => s.SortMode(GridSortMode.SingleColumn))
                                      .Selectable(s => s.Mode(GridSelectionMode.Single))
                                      .Height(500)
                                      .AutoBind(false)
                                      .Events(e => e.DataBound("setGridTotalRowsCount"))
                                      .DataSource(ds => ds.Ajax().Read(r => r.Action("getBillingRequestsByStatus", "demosources", new { c = "UNBD" })))
                                      .NoRecords()
                                )
                            </div>
                        </div>
                    </div>
                    <div class="col-4 px-1">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">@ViewBag.ForApprovalStatusName <span class="badge badge-warning" id="gridForApprovalCount">0</span></h5>
                                @(Html.Kendo().Grid(Model)
                                      .Name("gridForApproval")
                                      .Columns(column =>
                                      {
                                          column.Bound(b => b.BRReferenceNo).Width(150);
                                          column.Bound(b => b.BusinessUnitName).Width(200);
                                          column.Bound(b => b.ModifiedBy).Width(150);
                                          column.Bound(b => b.ModifiedOn).Width(150);
                                      })
                                      .Filterable()
                                      .Scrollable()
                                      .Resizable(r => r.Columns(true))
                                      .Sortable(s => s.SortMode(GridSortMode.SingleColumn))
                                      .Selectable(s => s.Mode(GridSelectionMode.Single))
                                      .Height(500)
                                      .AutoBind(false)
                                      .Events(e => e.DataBound("setGridTotalRowsCount"))
                                      .DataSource(ds => ds.Ajax().Read(r => r.Action("getBillingRequestsByStatus", "demosources", new { c = "FRAPRV" })))
                                      .NoRecords()
                                )
                            </div>
                        </div>
                    </div>
                    <div class="col-4 pl-1">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">@ViewBag.ApprovedStatusName <span class="badge badge-warning" id="gridApprovedCount">0</span></h5>
                                @(Html.Kendo().Grid(Model)
                                      .Name("gridApproved")
                                      .Columns(column =>
                                      {
                                          column.Bound(b => b.BRReferenceNo).Width(150);
                                          column.Bound(b => b.BusinessUnitName).Width(200);
                                          column.Bound(b => b.ModifiedBy).Width(150);
                                          column.Bound(b => b.ModifiedOn).Width(150);
                                      })
                                      .Filterable()
                                      .Scrollable()
                                      .Resizable(r => r.Columns(true))
                                      .Sortable(s => s.SortMode(GridSortMode.SingleColumn))
                                      .Selectable(s => s.Mode(GridSelectionMode.Single))
                                      .Height(500)
                                      .AutoBind(false)
                                      .Events(e => e.DataBound("setGridTotalRowsCount"))
                                      .DataSource(ds => ds.Ajax().Read(r => r.Action("getBillingRequestsByStatus", "demosources", new { c = "APRV" })))
                                      .NoRecords()
                                )
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>