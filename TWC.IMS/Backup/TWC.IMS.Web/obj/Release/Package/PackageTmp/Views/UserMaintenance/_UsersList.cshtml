@model IEnumerable<TWC.IMS.Web.Models.UserViewModel>

<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <ul class="header-text-button-container">
            <li>
                @if (this.Context.HasPermission("Users.CanAdd"))
                {
                    <a href="~/maintenance/details/u" class="btn btn-secondary" id="btnCreateNew" title="New"><span class="fas fa-plus"></span> New</a>
                }
            </li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12" id="grid-container">
        @(Html.Kendo().Grid(Model)
              .Name("gridUsers")
              .Columns(column =>
              {
                  column.Command(c =>
                  {
                      if (this.Context.HasPermission("Users.CanEdit"))
                      {
                          c.Custom("Edit").Text("<span class='fas fa-pen'></span>").HtmlAttributes(new { title = "Edit", data_cname = "maintenance", data_route = "u" }).Click("editItemUser");
                      }
                      if (this.Context.HasPermission("Users.CanDelete"))
                      {
                          c.Custom("Delete").Text("<span class='fas fa-trash'></span>").HtmlAttributes(new { title = "Delete" }).Click("deleteItemUser");
                      }
                      if (this.Context.HasPermission("Users.CanReset"))
                      {
                          c.Custom("Reset").Text("<span class='fas fa-redo'></span>").HtmlAttributes(new { title = "Reset Password" }).Click("resetPassword");
                      }
                      if (this.Context.HasPermission("Users.CanLock"))
                      {
                          c.Custom("Lock").Text("<span class='fas fa-lock'></span>").HtmlAttributes(new { title = "Lock Account" }).Click("lock");
                      }
                      if (this.Context.HasPermission("Users.CanUnlock"))
                      {
                          c.Custom("Unlock").Text("<span class='fas fa-lock-open'></span>").HtmlAttributes(new { title = "Unlock Account" }).Click("unlock");
                      }
                  }).Width(200).HtmlAttributes(new { @class = "k-alt command" });
                  column.Bound(c => c.AccountModel.UserName).Width(160);
                  column.Bound(c => c.AccountModel.RoleName).Width(150).ClientTemplate("<h5><span class='badge badge-warning font-weight-normal'>#=AccountModel.RoleName#</span></h5>");
                  column.Bound(c => c.AccountModel.Status).Width(90).ClientTemplate("<h5>#if (AccountModel.Status == 'Locked'){# <span class='badge badge-primary font-weight-normal'> #}else{# <span class='badge badge-success font-weight-normal'>#}# #=AccountModel.Status#</span></h5>");
                  column.Bound(c => c.ContactModel.Email).Width(300).ClientTemplate("<a href='mailto:#= ContactModel.Email #' target='_blank'>#= ContactModel.Email #</a>");
                  column.Bound(c => c.PersonalModel.EmployeeId).Width(130);
                  column.Bound(c => c.PersonalModel.FirstName).Width(150);
                  column.Bound(c => c.PersonalModel.MiddleName).Width(150);
                  column.Bound(c => c.PersonalModel.LastName).Width(150);
                  column.Bound(c => c.PersonalModel.Suffix).Width(90);
                  column.Bound(c => c.PersonalModel.Nickname).Width(100);
                  column.Bound(c => c.ActivationDate).Width(150);
                  column.Bound(c => c.DeactivationDate).Width(150);
                  column.Bound(c => c.ExpirationDate).Width(150);
                  column.Bound(c => c.Created).Width(150);
                  column.Bound(c => c.CreatedBy).Width(150);
                  column.Bound(c => c.Modified).Width(150);
                  column.Bound(c => c.ModifiedBy).Width(150);
              })
              .Filterable()
              .Pageable(p => p.Refresh(true))
              .Selectable(s => s.Mode(GridSelectionMode.Single))
              .Sortable(s => s.SortMode(GridSortMode.SingleColumn))
              .Scrollable(s => s.Height(300))
              .Resizable(r => r.Columns(true))
              .Events(e => e.DataBound("gridUsersOnDataBound"))
              .DataSource(ds =>
              {
                  ds.Ajax()
                  .PageSize(15)
                  .Read(r => r.Action("ReadUsers", "UserMaintenance"))
                  .Model(m => m.Id(c => c.Id));
              })
        )
    </div>
</div>
