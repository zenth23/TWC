@model IEnumerable<TWC.IMS.Web.Models.AccessViewModel>
@{
    ViewBag.Title = "Accesses";
}

<style>
    .k-grid td {
        white-space: nowrap !important;
    }
</style>

@Html.AntiForgeryToken()

<div class="row">
    <div class="col-sm-9 col-md-9 col-lg-9 col-xl-9">
        <ul class="header-text-button-container">
            <li>
                @if (this.Context.HasPermission("Accesses.CanAdd"))
                {
                    <a href="~/accesses/details" class="btn btn-sm btn-primary" id="btnCreateNew" title="New"><span class="fas fa-plus"></span></a>
                }
                else
                {
                    <h2><span class="fas fa-tasks"></span></h2>
                }
            </li>
            <li>
                <h2 class="mt-1">@ViewBag.Title</h2>
            </li>
        </ul>
    </div>
    <div class="col-sm-3 col-md-3 col-lg-3 col-xl-3">
        <a href="~/accessmodules/index" class="btn btn-light float-right" title="New">Back to Access Modules</a>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        @(Html.Kendo().Grid(Model)
              .Name("gridAccesses")
              .Columns(column =>
              {
                  column.Command(c =>
                  {
                      if (this.Context.HasPermission("Accesses.CanEdit"))
                      {
                          c.Custom("Edit").Text("<span class='fas fa-pen'></span>").HtmlAttributes(new { title = "Edit", data_cname = "accesses", data_propname = "UniqueKey" }).Click("application.grid.editItem");
                      }
                      if (this.Context.HasPermission("Accesses.CanDelete"))
                      {
                          c.Custom("Delete").Text("<span class='fas fa-trash'></span>").HtmlAttributes(new { title = "Delete", data_cname = "accesses", data_propname = "Name", data_propid = "UniqueKey" }).Click("application.grid.deleteItem");
                      }
                  }).Width(60).HtmlAttributes(new { @class = "k-alt command" });
                  column.Bound(c => c.Name).Width(300);
                  column.Bound(c => c.Description).Width(600);
                  column.Bound(c => c.CreatedOn).Width(150);
                  column.Bound(c => c.CreatedBy).Width(150);
                  column.Bound(c => c.ModifiedOn).Width(150);
                  column.Bound(c => c.ModifiedBy).Width(150);
              })
              .Filterable()
              .Pageable(p => p.Refresh(true)
                              .PageSizes(true)
                              .PageSizes(new int[] { 15, 30, 50, 100 })
                              .Input(true)
                              .ButtonCount(5))
              .Selectable(s => s.Mode(GridSelectionMode.Single))
              .Sortable(s => s.SortMode(GridSortMode.SingleColumn))
              .Scrollable(s => s.Height(400))
              .Resizable(r => r.Columns(true))
              .DataSource(ds =>
              {
                  ds.Ajax()
                  .PageSize(15)
                  .Read(r => r.Action("ReadAccesses", "Accesses"))
                  .Model(m => m.Id(c => c.Id));
              }))
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/Scripts/application/accesses.js?v=" + DateTime.Now.Ticks)
}
