@model TWC.IMS.Web.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset password";
}

<link href="~/Content/login.css" rel="stylesheet" />

@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Code)
    @Html.HiddenFor(model => model.UserId)

    <div class="form-signin">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
            @Html.Partial("_ValidationSummary")
        </div>
        <div class="signin-container">
            <h4 class="text-center text-bold">Reset Password</h4>
            <div class="form-group">
                @Html.LabelFor(m => m.Email, new { @class = "sr-only" })
                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", autofocus = "", placeholder = "Email", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Password, new { @class = "sr-only" })
                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "New Password", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "sr-only" })
                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm Password", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
                    <input type="submit" value="Reset" class="btn btn-secondary" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {

        });
    </script>
}
