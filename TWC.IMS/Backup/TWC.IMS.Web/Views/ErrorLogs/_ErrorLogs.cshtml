<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <div class="row">
            <div class="col-sm-8 col-md-8 col-lg-8 col-xl-8">
                <h3><span class="fas fa-exclamation-triangle mr-2"></span>Error Logs</h3>
            </div>
            <div class="col-sm-4 col-md-4 col-lg-4 col-xl-4">
                <button type="button" class="btn btn-outline-success ml-2 float-right" title="Export data to Excel" id="btnExportToExcelErrorLogs"><span class="fas fa-file-excel"></span> Export</button>
                @(Html.Kendo().DatePicker()
                      .Name("DateFilterErrorLogs")
                      .Start(CalendarView.Year)
                      .Depth(CalendarView.Year)
                      .Format("MMMM yyyy")
                      .Events(e => e.Change("loadGridDataErrorLogs"))
                      .Value(DateTime.Now.Date)
                      .HtmlAttributes(new { @class = "float-right" }))
            </div>
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-8">
        @(Html.Kendo().Grid<TWC.IMS.Web.Models.ErrorLogsViewModel>()
              .Name("gridErrorLogs")
              .Columns(column =>
              {
                  column.Command(c =>
                  {
                      c.Custom("View")
                       .Text("<span class='fas fa-eye'></span>")
                       .HtmlAttributes(new { title = "Error Log Details", data_cname = "errorlogs", data_propname = "UniqueKey" })
                       .Click("viewDetails");
                  }).Width(50).HtmlAttributes(new { @class = "k-alt command" });
                  column.Bound(c => c.CreatedOn).Width(150);
                  column.Bound(c => c.CreatedBy).Width(150);
                  column.Bound(c => c.ErrorNumber).Width(150);
                  column.Bound(c => c.MessageType).Width(150);
                  column.Bound(c => c.FriendlyErrorMessage).Width(300);
                  column.Bound(c => c.ErrorMessage).Width(300);
                  column.Bound(c => c.ImpactLevel).Width(150);
                  column.Bound(c => c.MethodName).Width(150);
                  column.Bound(c => c.AppVersion).Width(150);
                  column.Bound(c => c.Environment).Width(150);
              })
              .AutoBind(false)
              .Excel(e => e.FileName("errorlogs.xlsx").AllPages(true))
              .Filterable()
              .Pageable(p => p.Refresh(true)
                              .PageSizes(true)
                              .PageSizes(new int[] { 15, 30, 50, 100 })
                              .Input(true)
                              .ButtonCount(5))
              .Selectable(s => s.Mode(GridSelectionMode.Multiple))
              .Sortable(s => s.SortMode(GridSortMode.SingleColumn))
              .Scrollable(s => s.Height(445))
              .Resizable(r => r.Columns(true))
              .DataSource(ds =>
              {
                  ds.Ajax()
                  .PageSize(15)
                  .Read(r => r.Action("ReadErrorLogs", "errorlogs").Data("gridDateFilterErrorLogs"))
                  .Model(m => m.Id(c => c.Id));
              })
              .HtmlAttributes(new { style = "height:100%;" })
        )
    </div>
    <div class="col-4">
        <div class="row d-flex">
            <div class="card flex-fill mr-1">
                <div class="row card-body">
                    <div class="col-8 pr-0">
                        <span class="card-title text-muted">Total Logs</span>
                        <div class="col pl-0">
                            <span id="totalLoggedEL" class="wrap-text" style="font-size:3rem;">0</span>
                        </div>
                    </div>
                    <div class="col-3 px-0">
                        <span class="fas fa-exclamation-triangle float-right text-muted" style="font-size:2rem;"></span>
                    </div>
                </div>
            </div>

            <div class="card flex-fill ml-1">
                <div class="row card-body">
                    <div class="col-8 pr-0">
                        <span class="card-title text-muted">Total Logged Users</span>
                        <div class="col pl-0">
                            <span id="totalLoggedUsersEL" class="wrap-text" style="font-size:3rem;">0</span>
                        </div>
                    </div>
                    <div class="col-3 px-0">
                        <span class="fas fa-users float-right text-muted" style="font-size:2rem;"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            @Html.Partial("_AdminDashboardWidgetMethodHits")
        </div>
    </div>
</div>