@model TWC.IMS.Web.Models.EmailLogsViewModel
@{
    ViewBag.Title = "Email Log";
    bool isPartial = (bool)(ViewData["IS_PARTIAL"] ?? false);
}
<style>
    input, select, textarea, span.form-control-readonly {
        max-width: none !important;
    }
</style>

@if (!isPartial)
{
    <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
            <ul class="header-text-button-container">
                <li>
                </li>
                <li>
                    <h2><span class="fas fa-exclamation-triangle"></span> @ViewBag.Title</h2>
                </li>
            </ul>
        </div>
    </div>
    <hr />
}
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
    <div class="form-horizontal">
        <div class="form-group row">
            @Html.LabelFor(model => model.CreatedBy, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
            <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                @Html.DisplayFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>
        <div class="form-group row">
            @Html.LabelFor(model => model.CreatedOn, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
            <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                @Html.DisplayFor(model => model.CreatedOn, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>
        <hr />
        <div class="form-group row">
            @Html.LabelFor(model => model.From, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
            <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                @Html.EditorFor(model => model.From, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.To, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
            <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                @Html.EditorFor(model => model.To, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.Cc, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
            <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                @Html.EditorFor(model => model.Cc, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.Bcc, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
            <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                @Html.EditorFor(model => model.Bcc, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.Subject, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
            <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                @Html.EditorFor(model => model.Subject, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.Body, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
            <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                @Html.TextAreaFor(model => model.Body, 20, 20, new { @class = "form-control", @readonly = "readonly" })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
            <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                @Html.EditorFor(model => model.Status, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.ResentDatetime, htmlAttributes: new { @class = "control-label col-sm-2 col-md-2 col-lg-2 col-xl-2" })
            <div class="col-sm-10 col-md-10 col-lg-10 col-xl-10">
                @Html.EditorFor(model => model.ResentDatetime, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
            </div>
        </div>

        @if (!isPartial)
        {
            <hr />
            <div class="form-group">
                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                    <a href="@Url.Action("index", "emaillogs")" class="btn btn-outline-secondary">Back</a>
                </div>
            </div>
        }
    </div>
</div>