
@{
    ViewBag.Title = "Upload File";
}

<h2>Upload File</h2>


<div class="row">
    <div class="col-md-12" style="display: table;">
        <div id="dvDragFiles" style="height:300px;
             background-color:#eee;
             display:table-cell;
             text-align:center;
             padding:5px;
