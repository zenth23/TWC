@{
    string containerClass = (string)ViewData["ContainerClass"] ?? "container";
}

<!doctype html>
<html lang="en">
<head>
    @Html.Partial("_Head")
</head>
<body>
    @Html.Partial("_Spinner")
    @Html.Partial("_ProgressBarAnimated")
    @Html.Partial("_Navigation")

    @if (User.Identity.IsAuthenticated)
    {
       <!-- <div class="toggle_btn">
            @* <span class="fas fa-bars"></span>*@

            <img src="~/Content/Images/logo/smc_80x120.png" class="sidebar-logo">
        </div>-->
        @Html.Partial("_CustomSidenav_New")
    }
    <div class="body-content" style="margin-left: 5% !important; margin-right: 5% !important;">
        @RenderBody()
        @if (Request.IsAuthenticated)
        {
            @Html.Partial("_SessionExpiredWarningModal")
        }
    </div>
    @Html.Partial("_ScriptsSection")
    @RenderSection("scripts", required: false)
</body>
</html>
