@using Microsoft.AspNet.Identity
@{
    var appInstance = Application.Instance;
    var appEnv = appInstance.Environment.ToUpper();
    var mode = appInstance.DebugMode;
}
<script src="@Url.Content("~/Scripts/jquery.signalR-2.4.3.js")"></script>
<script src="@Url.Content("~/signalr/hubs")"></script>
<script src="@Url.Content("~/Scripts/application/system-notification.js")"></script>
@*<link href="~/Content/custom-background.css" rel="stylesheet" />
    <link href="~/Content/custom-style.css" rel="stylesheet" />*@

<style>
    #topNotif {
        padding-top: 0px !important;
        padding-bottom: 0px !important;
        border-radius: 5px !important;
        min-width: 20rem;
        max-width: 30rem;
    }

    .dropdown-item {
        white-space: normal !important;
    }

    .notif-icon {
        position: relative;
        font-size: 21px;
    }

    #notif-badge {
        position: absolute !important;
        top: -5px !important;
        right: -5px !important;
        display: block !important;
    }
</style>
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
    {
        @Html.AntiForgeryToken()
        <ul class="navbar-nav ml-auto">
            @if (string.Compare(appEnv, "prd", true) != 0)
            {
                <li class="nav-item ">
                    <div class="nav-link">
                        <span class="badge badge-danger" title="@appEnv Environment">@appEnv</span>
                        <span class="badge badge-info ml-n1" title="@mode Mode">@mode</span>
                    </div>
                </li>
            }
            else
            {
                if (string.Compare(mode, "debug", true) == 0)
                {
                    <li class="nav-item ">
                        <div class="nav-link">
                            <span class="badge badge-info ml-n1" title="@mode">@mode</span>
                        </div>
                    </li>
                }
            }

            @if (Request.IsAuthenticated)
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("privacystatement", "home")" style="margin-top: 3px;"><span class="fas fa-shield-alt"></span> Privacy Statement</a>
                </li>
            }

            <li class="nav-item dropdown">
                <a class="nav-link " href="#" id="navbardrop_notif" onclick="systemNotif.events.bellOnClick(this)" data-toggle="dropdown">
                    <i class="fas fa-bell text-light notif-icon" id="notif-icon"> </i>
                    <span class="badge badge-danger" id="notif-badge" style="display:none !important"></span>
                </a>

                <div class="dropdown-menu dropdown-menu-right " id="topNotif">
                </div>
            </li>

            <!-- Dropdown -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="navbardrop" data-toggle="dropdown">
                    <span title="Profile"><span class="fas fa-user-alt user-profile-thumbnail"></span> @User.Identity.Name.Trim().ToLower()</span>
                </a>
                <div class="dropdown-menu dropdown-menu-right">
                    <a class="dropdown-item" href="@Url.Action("Profile","Manage", null)"><span class="fas fa-user-alt text-primary"></span> Profile</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="javascript:document.getElementById('logoutForm').submit()"><span class="fas fa-sign-out-alt text-primary"></span> Logout</a>
                </div>
            </li>
        </ul>

        <ul class="navbar-nav ml-auto"></ul>
    }
}
else
{
    @*<div class="float-right mr-3">
            <a class="nav-link titlewhite" href="@Url.Action("privacystatement", "home")"><span class="fas fa-shield-alt"></span> Privacy Statement</a>
        </div>*@

    @*<ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("privacystatement", "home")"><span class="fas fa-shield-alt"></span> Privacy Statement</a>
            </li>
        </ul>*@
