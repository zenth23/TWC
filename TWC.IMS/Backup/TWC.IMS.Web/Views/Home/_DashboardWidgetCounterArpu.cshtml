@model IEnumerable<TWC.IMS.Models.ChartModels.AverageRevenuePerUnitReportModel>
<div class="col-6 pr-0" >
    <div class="card h-100">
        <div class="card-body">
            <span class="card-title text-muted">Average Revenue Per Unit</span>
            <div class="row" id="totalArpu">
                @* arpu = monthly recurring revenue / total customers *@
            </div>
        </div>
    </div>
</div>
<div class="col-3 pl-2 pr-1" >
    <div class="card h-100">
        <div class="card-body">
            <span class="card-title text-muted">Total BUs</span>
            <div class="row" id="totalBU">
            </div>
        </div>
    </div>
</div>
<div class="col-3 pl-1">
    <div class="card h-100">
        <div class="card-body"  title="Customer Churn Rate">
            <span class="card-title text-muted">CCR</span>
            <div class="row">
                <div class="col-12" style="text-align:right;">
                    <span class="text-muted" style="font-size:40px;">N/A</span>
                    @* ccr = customers lost / total customers *@
                </div>
            </div>
        </div>
    </div>
</div>

