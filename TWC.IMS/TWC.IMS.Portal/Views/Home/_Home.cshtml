<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jewelry Store</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f9f9f9;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 1200px;
            margin-top: 50px;
        }

        h1, h2 {
            font-weight: 600;
            color: #343a40;
            text-align: center;
        }

        .product-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .product-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            }

            .product-card img {
                width: 100%;
                height: 300px;
                object-fit: cover;
                transition: transform 0.3s ease;
            }

                .product-card img:hover {
                    transform: scale(1.1);
                }

            .product-card .card-body {
                background-color: #ffffff;
                padding: 20px;
                text-align: center;
            }

            .product-card .card-title {
                font-size: 1.25rem;
                color: #343a40;
                margin-bottom: 10px;
            }

            .product-card .card-text {
                font-size: 1.1rem;
                color: #f39c12;
            }

        .video-section iframe {
            border-radius: 12px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

        .comment-section {
            margin-top: 50px;
        }

        .comment-card {
            margin-top: 20px;
            border: none;
            border-radius: 12px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            background-color: #ffffff;
            padding: 15px;
        }

        .comment-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin-right: 10px;
        }

        .comment-body {
            display: flex;
            align-items: center;
        }

            .comment-body p {
                margin: 0;
                font-size: 1rem;
                color: #333;
            }

        .submit-comment-container {
            display: flex;
            margin-top: 20px;
            justify-content: space-between;
            align-items: center;
        }

            .submit-comment-container textarea {
                width: 80%;
                border-radius: 8px;
                border: 1px solid #ddd;
                padding: 10px;
                font-size: 1rem;
            }

            .submit-comment-container button {
                padding: 10px 20px;
                background-color: #f39c12;
                border: none;
                border-radius: 8px;
                color: #fff;
                cursor: pointer;
                font-size: 1rem;
            }

                .submit-comment-container button:hover {
                    background-color: #e67e22;
                }
    </style>
</head>
<body>

    <div class="container">
        <!-- Header Section -->
        <h1>Jewelry Store</h1>

        <!-- Featured Products Section -->
        <h2>Featured Products</h2>
        <div id="product-grid" class="row g-4">
            <!-- Sample Product 1 -->
            <div class="col-md-3">
                <div class="card product-card">
                    <img src="https://images.unsplash.com/photo-1558522312-472301f9ff1e" class="card-img-top" alt="Diamond Necklace">
                    <div class="card-body">
                        <h5 class="card-title">Diamond Necklace</h5>
                        <p class="card-text">$199.99</p>
                    </div>
                </div>
            </div>

            <!-- Sample Product 2 -->
            <div class="col-md-3">
                <div class="card product-card">
                    <img src="https://images.unsplash.com/photo-1611295685477-ff8f41e4f78e" class="card-img-top" alt="Gold Ring">
                    <div class="card-body">
                        <h5 class="card-title">Gold Ring</h5>
                        <p class="card-text">$299.99</p>
                    </div>
                </div>
            </div>

            <!-- Sample Product 3 -->
            <div class="col-md-3">
                <div class="card product-card">
                    <img src="https://images.unsplash.com/photo-1621332403-dbe84d7db122" class="card-img-top" alt="Platinum Bracelet">
                    <div class="card-body">
                        <h5 class="card-title">Platinum Bracelet</h5>
                        <p class="card-text">$399.99</p>
                    </div>
                </div>
            </div>

            <!-- Sample Product 4 -->
            <div class="col-md-3">
                <div class="card product-card">
                    <img src="https://images.unsplash.com/photo-1602059748728-e18c17d45565" class="card-img-top" alt="Emerald Earrings">
                    <div class="card-body">
                        <h5 class="card-title">Emerald Earrings</h5>
                        <p class="card-text">$499.99</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Video Section -->
        <div class="video-section mt-5 row">
            <div class="col-md-6">
                <h3>YouTube Video</h3>
                <iframe width="100%" height="315" src="https://www.youtube.com/embed/dQw4w9WgXcQ" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
            <div class="col-md-6">
                <h3>TikTok Video</h3>
                <iframe width="100%" height="315" src="https://www.tiktok.com/embed/6936207958121581829" frameborder="0"></iframe>
            </div>
        </div>

        <!-- Comment Section -->
        <div class="comment-section">
            <h2>Customer Comments</h2>

            <!-- Comment Input -->
            <div class="submit-comment-container">
                <textarea id="new-comment" class="form-control" placeholder="Add a comment" rows="3"></textarea>
                <button id="submit-comment">Submit</button>
            </div>

            <!-- Comments List -->
            <div id="comments-list" class="mt-4">
                <div class="comment-card">
                    <div class="comment-body">
                        <img src="https://www.w3schools.com/w3images/avatar2.png" alt="Avatar" class="comment-avatar">
                        <p>Love the Diamond Necklace! It's absolutely stunning!</p>
                    </div>
                </div>
                <div class="comment-card">
                    <div class="comment-body">
                        <img src="https://www.w3schools.com/w3images/avatar2.png" alt="Avatar" class="comment-avatar">
                        <p>Gold Ring is beautiful, it fits perfectly. Highly recommend!</p>
                    </div>
                </div>
                <div class="comment-card">
                    <div class="comment-body">
                        <img src="https://www.w3schools.com/w3images/avatar2.png" alt="Avatar" class="comment-avatar">
                        <p>Excellent quality of Platinum Bracelet. Worth the price!</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    // Simulate adding a new comment
    $(document).ready(function() {
        // Submit comment event
        $("#submit-comment").on("click", function() {
            var newComment = $("#new-comment").val();
                        if (newComment.trim()) {
                // Append the new comment to the comment section
                var commentHTML = `
                    <div class="comment-card">
                        <div class="comment-bodys
                            <img src="https://www.w3schools.com/w3images/avatar2.png" alt="Avatar" class="comment-avatar">
                            <p>${newComment}</p>
                        </div>
                    </div>
                `;
                $("#comments-list").prepend(commentHTML);  // Adds comment at the top
                $("#new-comment").val('');  // Clear the comment box
            }
        });
    });
    </script>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
